# Public production defaults. APP_KEY is generated ON THE SERVER by Composer.
APP_NAME="John Lawrence Cambalon"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bright-mediumturquoise-parrot-86.hostingersite.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=single
LOG_LEVEL=warning

# The public portfolio does not need a database or queue worker.
DB_CONNECTION=sqlite
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
INERTIA_SSR_ENABLED=false
